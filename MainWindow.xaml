<Window x:Class="NativeGameHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Aurora Game Hub - Native Edition"
        Height="840" Width="1320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown"
        FontFamily="Segoe UI, Plus Jakarta Sans, Arial">

    <Window.Resources>
        <!-- Window Control Button Styles -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252A34"/>
                    <Setter Property="Foreground" Value="#F0F6FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E63946"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Filter Tab Buttons -->
        <Style x:Key="FilterTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E232B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Shadow and Rounded Corners -->
    <Border Background="#090B0E" CornerRadius="18" BorderBrush="#1F242C" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- Dynamic Background Hero Art -->
            <Image x:Name="BackdropImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.30"/>

            <!-- Ambient Dynamic Color Glow -->
            <Border x:Name="AmbientGlowBorder" Width="600" Height="500" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-80,0,0,0" Opacity="0.35">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop x:Name="AmbientGlowStop" Color="#E63946" Offset="0.0"/>
                        <GradientStop Color="#00090B0E" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Gradient Overlays for Readability -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.8,0.2" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#00090B0E" Offset="0.0"/>
                        <GradientStop Color="#EA090B0E" Offset="0.85"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#FD090B0E" Offset="0.0"/>
                        <GradientStop Color="#CC090B0E" Offset="0.4"/>
                        <GradientStop Color="#80090B0E" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Main Layout Grid -->
            <Grid Margin="32,20,32,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Spotlight -->
                    <RowDefinition Height="*"/>
                    <!-- Carousel Shelf -->
                </Grid.RowDefinitions>

                <!-- 1. Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#00F2FE" Margin="0,0,14,0">
                            <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AURORA GAME HUB" FontWeight="ExtraBold" FontSize="16" Foreground="#F0F6FC"/>
                            <TextBlock Text="Native Edition • Ultra Performance" FontSize="10" Foreground="#8B949E" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Category Filter Tabs -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#141820" BorderBrush="#252B35" BorderThickness="1" CornerRadius="20" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabAll" Content="Tất Cả (5)" Style="{StaticResource FilterTabBtn}" Background="#21262D" Foreground="#FFFFFF" Click="FilterTab_Click" Tag="all"/>
                            <Button x:Name="TabAction" Content="Hành Động" Style="{StaticResource FilterTabBtn}" Click="FilterTab_Click" Tag="action"/>
                            <Button x:Name="TabHorror" Content="Kinh Dị" Style="{StaticResource FilterTabBtn}" Click="FilterTab_Click" Tag="horror"/>
                            <Button x:Name="TabInstalled" Content="Đã Cài Đặt" Style="{StaticResource FilterTabBtn}" Click="FilterTab_Click" Tag="installed"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Hardware Specs HUD, Clock & Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Hardware Specs Pill (Auto-Detected) -->
                        <Border Background="#12161E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="12,6" Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="HudCpuText" Text="⚡ CPU" FontSize="11" FontWeight="Bold" Foreground="#00F2FE" Margin="0,0,8,0"/>
                                <TextBlock Text="•" Foreground="#484F58" Margin="0,0,8,0"/>
                                <TextBlock x:Name="HudGpuText" Text="🎮 GPU" FontSize="11" FontWeight="SemiBold" Foreground="#51CF66" Margin="0,0,8,0"/>
                                <TextBlock Text="•" Foreground="#484F58" Margin="0,0,8,0"/>
                                <TextBlock x:Name="HudRamText" Text="💾 RAM" FontSize="11" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                            </StackPanel>
                        </Border>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock x:Name="ClockTimeText" Text="20:45" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="ClockDateText" Text="THỨ NĂM, 29/10" FontSize="10" Foreground="#8B949E" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <!-- Window Controls -->
                        <Button Content="—" Style="{StaticResource WindowControlBtn}" Click="Minimize_Click" ToolTip="Thu nhỏ"/>
                        <Button x:Name="MaximizeBtn" Content="▢" Style="{StaticResource WindowControlBtn}" Click="Maximize_Click" ToolTip="Phóng to / Thu nhỏ"/>
                        <Button Content="✕" Style="{StaticResource CloseBtn}" Click="Close_Click" ToolTip="Đóng"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Spotlight Hero Section -->
                <Grid Grid.Row="1" VerticalAlignment="Top" MaxWidth="780" HorizontalAlignment="Left" Margin="10,6,0,0">
                    <StackPanel>
                        <!-- Meta bar -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border CornerRadius="4" Background="#1E293B" Padding="8,2" Margin="0,0,10,0">
                                <TextBlock x:Name="DevText" Text="IO Interactive" Foreground="#00F2FE" FontWeight="Bold" FontSize="11"/>
                            </Border>
                            <TextBlock Text="•" Foreground="#484F58" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GenreText" Text="Hành Động / Lén Lút" Foreground="#C9D1D9" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="•" Foreground="#484F58" Margin="10,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="YearText" Text="2021" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Title -->
                        <TextBlock x:Name="TitleText" Text="HITMAN World of Assassination" FontWeight="ExtraBold" FontSize="40" Foreground="#FFFFFF" Margin="0,0,0,12" TextWrapping="Wrap">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.8" Direction="270" ShadowDepth="3"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Tags Container -->
                        <WrapPanel x:Name="TagsPanel" Margin="0,0,0,14">
                            <!-- Dynamic Tag Badges -->
                        </WrapPanel>

                        <!-- Description -->
                        <TextBlock x:Name="DescText" Text="Nhập vai sát thủ số 1 thế giới..." Foreground="#D0D7DE" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,18" MaxWidth="700">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.9" ShadowDepth="1"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Buttons Row -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Play Button -->
                            <Button x:Name="PlayBtn" Click="Play_Click" Width="185" Height="48" Margin="0,0,14,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="#00F2FE" CornerRadius="14">
                                            <Border.Effect>
                                                <DropShadowEffect x:Name="BtnGlow" BlurRadius="24" Color="#00F2FE" Opacity="0.45" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="PlayBtnIcon" Text="▶" FontSize="15" Foreground="#090B0E" FontWeight="Bold" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="PlayBtnText" Text="CHƠI NGAY" FontSize="15" Foreground="#090B0E" FontWeight="ExtraBold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Open Folder Button -->
                            <Button Click="OpenFolder_Click" Width="140" Height="48" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="FolderBorder" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="14">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="📁" FontSize="15" Margin="0,0,8,0"/>
                                                <TextBlock Text="Thư Mục" FontSize="13" Foreground="#F0F6FC" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FolderBorder" Property="Background" Value="#21262D"/>
                                                <Setter TargetName="FolderBorder" Property="BorderBrush" Value="#484F58"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 3. Bottom Carousel Shelf (Lifted up directly below action buttons) -->
                <Grid Grid.Row="2" VerticalAlignment="Top" Margin="0,18,0,0">
                    <ScrollViewer x:Name="CardsScrollViewer" Height="270" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="CardsScrollViewer_PreviewMouseWheel">
                        <StackPanel x:Name="CardsContainer" Orientation="Horizontal" Margin="10,22,0,8"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 4. Launch Choice Popup Modal -->
            <Grid x:Name="LaunchChoiceOverlay" Visibility="Collapsed" Background="#D905070A">
                <Border Width="500" Background="#12161F" BorderBrush="#262D38" BorderThickness="1.5" CornerRadius="20" Padding="30,26" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.9"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header with Close button -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="20" Margin="0,0,10,0"/>
                                <TextBlock Text="KHỞI ĐỘNG TRÒ CHƠI" FontWeight="ExtraBold" FontSize="16" Foreground="#F0F6FC"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource WindowControlBtn}" HorizontalAlignment="Right" Click="CancelLaunchChoice_Click" ToolTip="Đóng"/>
                        </Grid>

                        <!-- Game Title -->
                        <TextBlock x:Name="ChoiceGameNameText" Text="HITMAN World of Assassination" FontWeight="Bold" FontSize="18" Foreground="#00F2FE" Margin="0,0,0,10"/>

                        <!-- Question / Info -->
                        <TextBlock Text="Bạn có muốn kích hoạt Gaming Turbo Boost để dọn dẹp bộ nhớ RAM, tối ưu CPU i7 và mở rộng VRAM trước khi vào game không?" Foreground="#8B949E" FontSize="12.5" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <!-- Options Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Direct Launch Option -->
                            <Button Click="ChoiceDirectLaunch_Click" Width="170" Height="44" Margin="0,0,12,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="DirectBorder" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="▶" FontSize="12" Margin="0,0,8,0" Foreground="#C9D1D9"/>
                                                <TextBlock Text="Vào Game Trực Tiếp" FontSize="12.5" Foreground="#F0F6FC" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DirectBorder" Property="Background" Value="#21262D"/>
                                                <Setter TargetName="DirectBorder" Property="BorderBrush" Value="#484F58"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Turbo Boost Option -->
                            <Button Click="ChoiceBoostLaunch_Click" Width="200" Height="44" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BoostBorder" Background="#00F2FE" CornerRadius="12">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" Color="#00F2FE" Opacity="0.4" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" Foreground="#090B0E"/>
                                                <TextBlock Text="Kích Hoạt Turbo Boost" FontSize="12.5" Foreground="#090B0E" FontWeight="ExtraBold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoostBorder" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Turbo Boost Progress Overlay Modal -->
            <Grid x:Name="BoostOverlay" Visibility="Collapsed" Background="#E605070A">
                <Border Width="560" Background="#12161F" BorderBrush="#00F2FE" BorderThickness="1.5" CornerRadius="20" Padding="34,30" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="45" Color="#00F2FE" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Modal Header -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <TextBlock Text="⚡" FontSize="28" Margin="0,0,10,0"/>
                            <TextBlock Text="GAMING TURBO BOOST" FontWeight="ExtraBold" FontSize="21" Foreground="#00F2FE" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Target Game Name -->
                        <TextBlock x:Name="BoostGameNameText" Text="HITMAN World of Assassination" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <!-- Progress Bar Container -->
                        <Border Height="8" Background="#1F242C" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,18">
                            <ProgressBar x:Name="BoostProgressBar" Minimum="0" Maximum="100" Value="10" Height="8" BorderThickness="0" Background="Transparent" Foreground="#00F2FE"/>
                        </Border>

                        <!-- Status Text -->
                        <TextBlock x:Name="BoostStatusText" Text="Đang dọn dẹp bộ nhớ RAM và mở rộng VRAM..." FontWeight="Bold" FontSize="14" Foreground="#F0F6FC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="BoostDetailsText" Text="Quét các tiến trình nền và giải phóng bộ đệm không cần thiết" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,26"/>

                        <!-- Skip Button -->
                        <Button Content="Bỏ Qua và Khởi Chạy Ngay ➔" Click="SkipBoost_Click" Width="230" Height="40" Background="#1F242C" Foreground="#C9D1D9" FontWeight="SemiBold" FontSize="12" Cursor="Hand" HorizontalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 6. Game Not Installed Notification Modal -->
            <Grid x:Name="NotInstalledOverlay" Visibility="Collapsed" Background="#D905070A">
                <Border Width="480" Background="#12161F" BorderBrush="#262D38" BorderThickness="1.5" CornerRadius="20" Padding="30,26" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.9"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header with Close button -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎮" FontSize="20" Margin="0,0,10,0"/>
                                <TextBlock Text="THÔNG BÁO BỘ SƯU TẬP" FontWeight="ExtraBold" FontSize="16" Foreground="#F0F6FC"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource WindowControlBtn}" HorizontalAlignment="Right" Click="CloseNotInstalledOverlay_Click" ToolTip="Đóng"/>
                        </Grid>

                        <!-- Game Name Card -->
                        <Border Background="#1A202C" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="NotInstalledGameNameText" Text="Black Myth: Wukong" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,4"/>
                                <TextBlock Text="○ Bản Trưng Bày Showcase (Chưa có trên ổ cứng)" FontSize="11.5" FontWeight="SemiBold" Foreground="#E67700"/>
                            </StackPanel>
                        </Border>

                        <!-- Details message -->
                        <TextBlock x:Name="NotInstalledDescText" Text="Tựa game này đang được trưng bày dạng Demo trong bộ sưu tập để bạn tham khảo thông tin và chiêm ngưỡng đồ họa. Khi nào bạn tải hoặc cài đặt game vào ổ cứng (E:\...), Aurora Game Hub sẽ tự động nhận diện và sẵn sàng khởi động!" Foreground="#8B949E" FontSize="12.5" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,22"/>

                        <!-- Action Button -->
                        <Button Content="ĐÃ HIỂU" Click="CloseNotInstalledOverlay_Click" Width="130" Height="42" Background="#21262D" Foreground="#F0F6FC" FontWeight="Bold" FontSize="12.5" Cursor="Hand" HorizontalAlignment="Right">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#363E4A" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
